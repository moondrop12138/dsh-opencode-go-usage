{
  "name": "dsh-opencode-go-usage",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode Go subscription usage page: a left-sidebar panel in the DSH Web UI showing the official 5h / weekly / monthly used-percent windows, reset countdowns and a local sampling trail",
  "type": "module",
  "main": "lib/host.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moondrop12138/dsh-opencode-go-usage.git"
  },
  "homepage": "https://github.com/moondrop12138/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/moondrop12138/dsh-opencode-go-usage/issues"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "INTERFACES.md",
    "screenshots.json",
    "assets/"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "opencode-go",
    "usage",
    "quota"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/host.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
